{
  "permissions": {
    "allow": [
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run test)",
      "Bash(bun run test:*)",
      "Bash(bun run build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Edit(/.claude/skills/ui-review/**)",
      "WebFetch(domain:www.usehallmark.com)",
      "Bash(curl -s https://www.usehallmark.com/examples/hum-07/)",
      "Bash(curl -s https://www.usehallmark.com/examples/hum-07/tokens.css)",
      "Bash(mkdir -p public/images && cp /private/tmp/claude-501/-Users-andy2015bui-Desktop-detox-web/0308bc09-9828-4d61-b9c5-585a01fe4801/images/1.png public/images/logo.png)",
      "mcp__exa__web_fetch_exa",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "Bash(curl -s http://localhost:3000)",
      "Bash(curl -s -I https://www.usehallmark.com/examples/hum-07/)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rmdir *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(bun add *)",
      "Bash(bun remove *)",
      "Bash(bun install *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)"
    ],
    "additionalDirectories": [
      "/private/tmp/claude-501/-Users-andy2015bui-Desktop-detox-web/0308bc09-9828-4d61-b9c5-585a01fe4801/images"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edit.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/quick-check.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-stop.js\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  }
}
